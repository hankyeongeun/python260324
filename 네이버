import requests
from bs4 import BeautifulSoup
from openpyxl import Workbook

url = "https://search.naver.com/search.naver"
params = {
    "where": "nexearch",
    "sm": "top_hty",
    "fbm": "0",
    "ie": "utf8",
    "query": "아이폰17"
}
headers = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36",
    "Accept-Language": "ko-KR,ko;q=0.9,en-US;q=0.8,en;q=0.7"
}

resp = requests.get(url, params=params, headers=headers, timeout=10)
resp.raise_for_status()

soup = BeautifulSoup(resp.text, "html.parser")

items = []
# 네이버 뉴스/동영상 등의 제목 요소들, 필요에 따라 선택자 조정
for a in soup.select("a.news_tit, a.fender-ui_228e3bd1.TdZKOIuRcDmFG3NkVP7U"):
    title = a.get_text(separator=" ", strip=True)
    link = a.get("href", "").strip()
    if title:
        items.append((title, link))

wb = Workbook()
ws = wb.active
ws.title = "NaverCrawl"
ws.append(["No", "Title", "Link"])

for idx, (title, link) in enumerate(items, start=1):
    ws.append([idx, title, link])

output_file = "naver_result.xlsx"
wb.save(output_file)
print(f"저장 완료: {output_file} (총 {len(items)}개 항목)")